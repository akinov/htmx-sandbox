{
  "name": "htmx-sandbox",
  "version": "1.0.0",
  "description": "HTMX sandbox with Hono server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "bun run tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "hono": "^4.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.2",
    "@playwright/test": "^1.49.1",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "lint-staged": {
    "*.ts": "bun run tsc --noEmit --skipLibCheck"
  }
}
